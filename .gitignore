# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Claude Code harness runtime files (scheduled_tasks.lock, etc.) — everything
# under .claude/ is ignored except committed skills (e.g. .claude/skills/
# seo-aeo/SKILL.md), which are added explicitly by path.
.claude/*
!.claude/skills/

# typescript
*.tsbuildinfo
next-env.d.ts
